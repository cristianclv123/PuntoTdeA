# Plantilla de variables de entorno. NO contiene valores reales.
# Copia a `.env` y completa los valores. `.env` esta en .gitignore: no lo subas.

# --- Django ---
# Obligatorio cuando DJANGO_DEBUG=false (produccion).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Token para la API interna /campanas/api/. Sin el y con DEBUG=false, la UI de
# campanas queda sin datos.
INTERNAL_API_TOKEN=

# --- Meta WhatsApp Cloud API ---
# Generado por configurar_meta.ps1. No versionar.
META_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
META_GRAPH_API_URL=https://graph.facebook.com
META_REQUEST_TIMEOUT=20

# --- Meta Marketing API (anuncios en WhatsApp Status) ---
# Requiere un token de usuario con permiso `ads_management`; el token de
# sistema de WhatsApp no sirve para anuncios.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_FB_PAGE_ID=
META_WHATSAPP_PHONE=
META_BUSINESS_ID=